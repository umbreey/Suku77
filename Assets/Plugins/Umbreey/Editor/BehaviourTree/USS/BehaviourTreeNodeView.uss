#title {
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgba(200, 182, 255, 0);
    align-self: center;
}

#description {
    font-size: 12px;
    max-width: 200px;
    white-space: normal;
    flex-wrap: wrap;
    max-height: none;
    flex-grow: 0;
    text-overflow: clip;
    -unity-font-style: italic;
    -unity-text-align: upper-center;
}

#node-border {
    background-color: rgb(60, 60, 60);
    border-left-color: rgb(60, 60, 60);
    border-right-color: rgb(60, 60, 60);
    border-top-color: rgb(60, 60, 60);
    border-bottom-color: rgb(60, 60, 60);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}

#input {
    align-items: center;
    align-self: stretch;
    background-color: rgb(255, 209, 102);
}

#output {
    align-self: stretch;
    align-items: center;
}

#divider {
    background-color: rgb(200, 182, 255);
    min-height: 1px;
}

#selection-border {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-left-color: rgb(17, 138, 178);
    border-right-color: rgb(17, 138, 178);
    border-top-color: rgb(17, 138, 178);
    border-bottom-color: rgb(17, 138, 178);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
}

:hover > #selection-border {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

:selected > #selection-border {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

:hover:selected > #selection-border {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.running #selection-border {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(255, 209, 102);
    border-right-color: rgb(255, 209, 102);
    border-top-color: rgb(255, 209, 102);
    border-bottom-color: rgb(255, 209, 102);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.success #selection-border {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(6, 214, 160);
    border-right-color: rgb(6, 214, 160);
    border-top-color: rgb(6, 214, 160);
    border-bottom-color: rgb(6, 214, 160);
}

.failure #selection-border {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(239, 71, 111);
    border-right-color: rgb(239, 71, 111);
    border-top-color: rgb(239, 71, 111);
    border-bottom-color: rgb(239, 71, 111);
}

.node {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

.root #output {
    background-color: rgb(200, 182, 255);
}

.composite #output {
    background-color: rgb(200, 182, 255);
}
