<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Plugins/Wakoo/Editor/BehaviourTree/USS/BehaviourTreeEditor.uss?fileID=7433441132597879392&amp;guid=01c7f4f0416a0b140865639d240bb962&amp;type=3#BehaviourTreeEditor" />
    <uie:Toolbar>
        <uie:ObjectField label="文件:" name="objectField" style="-unity-text-align: middle-left;" />
        <uie:ToolbarMenu tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="toolbarMenu" text="操作" />
